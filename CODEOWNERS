# Domain-based ownership for iov-cloud-parent-proto
# Each domain team owns their submodule directory.
# Platform team maintains the root config, parent POM and release pipeline.

# Platform team
/pom.xml                                 @open-iov/platform
/buf.yaml                                @open-iov/platform
/buf.gen.yaml                            @open-iov/platform
/buf.lock                                @open-iov/platform
/CODEOWNERS                              @open-iov/platform
/provenance/                             @vehicle-cloud-platform

# VMD domain - Vehicle Management & Diagnostics
/iov-cloud-proto-vmd/                    @open-iov/vmd-team

# Vehicle Cloud Boundary Common - Envelope & cross-domain transport metadata
/iov-cloud-proto-vehicle-common/         @vehicle-cloud-platform @vehicle-platform

# FOTA domain - Vehicle Cloud Boundary FOTA contracts
/iov-cloud-proto-fota/                   @iov-ota @cgw-fota @vehicle-platform

# VAGW domain - cloud-internal technical delivery status (not vehicle boundary)
/iov-cloud-proto-vagw/                   @vagw-team @iov-ota

# KeyProv domain - V2C initial business key provisioning security contract
# Envelope mapping requires security payload owner + vehicle-common owner;
# keyprov field semantics require VMD + VAGW + TBOX-TSP + TBOX-SEC/VEH-PROTO owners.
/iov-cloud-proto-keyprov/                @vehicle-security @vmd-team @vagw-team @tbox-tsp @tbox-sec
